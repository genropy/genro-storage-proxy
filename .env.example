# genro-storage-proxy Environment Variables
# Copy this file to .env and customize

# JWT Secret (required if using JWT auth)
JWT_SECRET=your-secret-key-here-change-me

# Admin API Token (required if admin API enabled)
ADMIN_TOKEN=your-admin-token-here-change-me

# API Keys (required if using API key auth)
# Comma-separated list
# API_KEYS=key1,key2,key3

# Server Configuration (optional, overrides INI)
# STORAGE_PROXY_HOST=0.0.0.0
# STORAGE_PROXY_PORT=8080
# LOG_LEVEL=info

# AWS Credentials (optional, if not using IAM roles)
# AWS_ACCESS_KEY_ID=your-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_DEFAULT_REGION=eu-west-1

# GCS Credentials (optional)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Azure Credentials (optional)
# AZURE_STORAGE_ACCOUNT_NAME=myaccount
# AZURE_STORAGE_ACCOUNT_KEY=your-key
